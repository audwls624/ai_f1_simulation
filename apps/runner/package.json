{
  "name": "@f1sim/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "시즌 실행 CLI. API 키는 여기만 (docs/DESIGN.md 13절)",
  "exports": {
    ".": {
      "@f1sim/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "race": "tsx --conditions=@f1sim/source src/cli.ts race",
    "replay": "tsx --conditions=@f1sim/source src/cli.ts replay",
    "season": "tsx --conditions=@f1sim/source src/cli.ts season",
    "golden": "tsx --conditions=@f1sim/source src/cli.ts golden"
  },
  "dependencies": {
    "@f1sim/agents": "workspace:*",
    "@f1sim/core": "workspace:*",
    "@f1sim/harness": "workspace:*",
    "zod": "^4.6.7"
  }
}
