{
  "name": "f1sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI 팀 F1 전략 시뮬레이션 — 설계는 docs/DESIGN.md",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "race": "pnpm -F @f1sim/runner season --teams-file teams.example.yaml",
    "viewer": "pnpm -F @f1sim/web dev",
    "lint": "eslint . --max-warnings=0 && pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
