{
  "name": "@f1sim/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "밸런스 테스트 하네스 (docs/DESIGN.md 12절)",
  "exports": {
    ".": {
      "@f1sim/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "gen-tracks": "tsx --conditions=@f1sim/source src/cli.ts gen-tracks"
  },
  "dependencies": {
    "@f1sim/agents": "workspace:*",
    "@f1sim/core": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
